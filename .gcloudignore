# This file specifies files that should NOT be uploaded to Google Cloud
# when using gcloud commands.

# Ignore git files
.git
.gitignore
.gitattributes

# Ignore Node modules (will reinstall in cloud)
node_modules/
npm-debug.log*

# Ignore environment files with secrets
.env
.env.local
.env.*.local

# Ignore test files
tests/
*.test.js

# Ignore backups
*.bak

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp

# Ignore documentation
README.md
CONTRIBUTING.md
