{
	"name": "lavoro",
	"version": "1.0.0",
	"private": true,
	"description": "Lavoro daily assistant app.",
	"scripts": {
		"dev": "npm --prefix backend run dev",
		"start": "npm --prefix backend start",
		"health": "npm --prefix backend run health",
		"seed": "node scripts/seed.js",
		"migrate": "npm --prefix backend run migrate",
		"eval": "node scripts/eval-agent.js",
		"test": "node --test 'tests/**/*.test.js'",
		"test:coverage": "c8 node --test 'tests/**/*.test.js'",
		"lint": "node --check backend/server.js && node --check frontend/script.js",
		"typecheck": "node --check backend/server.js && node --check frontend/script.js",
		"build": "node --check backend/server.js && node --check frontend/script.js && node -e \"const fs=require('fs'); ['frontend/index.html','frontend/style.css','frontend/script.js'].forEach(f => { if (!fs.existsSync(f)) throw new Error('Missing asset: ' + f); }); console.log('Static build assets verified');\""
	},
	"devDependencies": {
		"c8": "^12.0.0",
		"supertest": "^7.2.2"
	},
	"c8": {
		"include": [
			"backend/src/**/*.js"
		],
		"exclude": [
			"backend/src/config/telemetry.js"
		],
		"all": true,
		"reporter": [
			"text",
			"text-summary"
		]
	}
}
