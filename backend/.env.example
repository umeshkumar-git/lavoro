PORT=10000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview


PORT=10000
NODE_ENV=development

# AI providers (app runs on demo data if GEMINI_API_KEY is unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional infra (in-memory fallback used if unset)
REDIS_URL=redis://localhost:6379

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info


